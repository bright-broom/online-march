# ── Database ─────────────────────────────────────────────
# 未設定 → 組込み PGlite (.data/pglite) を自動作成・migrate・seed
# Vercel: Neon (Marketplace) を接続すると自動で入ります
DATABASE_URL=
# PGLITE_DIR=.data/pglite   # memory:// でインメモリ

# ── Auth (Better Auth) ───────────────────────────────────
BETTER_AUTH_SECRET=         # openssl rand -base64 32
BETTER_AUTH_URL=              # 本番URL。ローカルは空でOK（リクエストから自動判定）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments (Stripe) — 未設定ならデモ決済 ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) — 未設定ならコンソール出力 ────────────
RESEND_API_KEY=
EMAIL_FROM="あわじ玉ねぎマルシェ <noreply@your-domain.jp>"

# ── Storage (Vercel Blob) — 未設定なら public/uploads ────
BLOB_READ_WRITE_TOKEN=

# ── Cron ────────────────────────────────────────────────
CRON_SECRET=                # Vercel Cron が Authorization: Bearer で送信

# デモアカウント表示・デモ決済を本番でも許可する場合 true
DEMO_MODE=
